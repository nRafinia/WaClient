import { ListView } from "std-widgets.slint";
import { Theme, Avatar } from "theme.slint";
import { IconClose } from "icons.slint";
import { TextDir } from "chat_search.slint";

// One line of the votes list: an option heading (`header`) or one voter of
// the option above it.
export struct VoteRow {
    header: bool,
    // Option name (header) or the voter's display name.
    text: string,
    // Header: number of votes for the option.
    count: int,
    // Voter: when the vote was cast.
    time: string,
    initials: string,
    tint: color,
    avatar: image,
    has-avatar: bool,
}

// State of the "View votes" dialog (Rust: app/poll_ui.rs). The rows are
// rebuilt whenever the chat changes while it is open.
export global PollVotes {
    in-out property <bool> open;
    in property <string> question;
    in property <[VoteRow]> rows;
    callback close();
}

// Modal dialog that covers its parent: who voted for which option.
export component PollVotesDialog inherits Rectangle {
    background: #000000b0;
    TouchArea { }

    FocusScope {
        width: parent.width;
        height: parent.height;
        capture-key-pressed(e) => {
            if (e.text == Key.Escape) {
                PollVotes.close();
                return accept;
            }
            return reject;
        }

        Rectangle {
            width: min(420px, parent.width - 32px);
            height: min(520px, parent.height - 32px);
            background: Theme.panel;
            border-radius: 12px;
            clip: true;

            Text {
                x: 20px;
                y: 14px;
                width: parent.width - 80px;
                height: 24px;
                text: "Votes";
                color: Theme.text;
                font-size: 18px;
                font-weight: 600;
            }
            Text {
                x: 20px;
                y: 40px;
                width: parent.width - 80px;
                height: 20px;
                text: PollVotes.question;
                color: Theme.secondary;
                font-size: 13px;
                horizontal-alignment: TextDir.is-rtl(self.text) ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                overflow: elide;
            }
            Rectangle {
                x: parent.width - 48px;
                y: 12px;
                width: 32px;
                height: 32px;
                border-radius: 16px;
                background: close-ta.has-hover ? Theme.selected : transparent;
                IconClose {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    size: 16px;
                    color: Theme.secondary;
                }
                close-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { PollVotes.close(); }
                }
            }
            Rectangle {
                y: 68px;
                height: 1px;
                background: Theme.divider;
            }

            ListView {
                x: 0px;
                y: 69px;
                width: parent.width;
                height: parent.height - 69px;

                for r in PollVotes.rows: Rectangle {
                    height: r.header ? 40px : 52px;

                    if r.header: Rectangle {
                        background: Theme.input-bg;
                        Text {
                            x: 20px;
                            width: parent.width - 120px;
                            height: parent.height;
                            text: r.text;
                            color: Theme.text;
                            font-size: 14px;
                            font-weight: 600;
                            horizontal-alignment: TextDir.is-rtl(self.text) ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Text {
                            x: parent.width - 100px;
                            width: 80px;
                            height: parent.height;
                            text: "\{r.count} \{r.count == 1 ? "vote" : "votes"}";
                            color: Theme.secondary;
                            font-size: 12px;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }
                    }
                    if !r.header: Rectangle {
                        Avatar {
                            x: 20px;
                            y: (parent.height - self.height) / 2;
                            size: 36px;
                            source: r.avatar;
                            has-image: r.has-avatar;
                            initials: r.initials;
                            tint: r.tint;
                        }
                        Text {
                            x: 68px;
                            y: 8px;
                            width: parent.width - 88px;
                            height: 20px;
                            text: r.text;
                            color: Theme.text;
                            font-size: 14px;
                            horizontal-alignment: TextDir.is-rtl(self.text) ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                            overflow: elide;
                        }
                        Text {
                            x: 68px;
                            y: 28px;
                            width: parent.width - 88px;
                            height: 16px;
                            text: r.time;
                            color: Theme.secondary;
                            font-size: 12px;
                            overflow: elide;
                        }
                    }
                }
            }
        }
    }
}
