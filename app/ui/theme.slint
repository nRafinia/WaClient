// Number of PopupWindows on screen. Esc is left to them (Slint closes the
// topmost popup) instead of being used by the window-level handler.
export global PopupState {
    in-out property <int> open;
}

export global Theme {
    out property <color> bg: #111b21;
    out property <color> panel: #202c33;
    out property <color> chat-bg: #0b141a;
    out property <color> my-bubble: #005c4b;
    out property <color> their-bubble: #202c33;
    out property <color> text: #e9edef;
    out property <color> secondary: #8696a0;
    out property <color> accent: #00a884;
    out property <color> badge: #00a884;
    out property <color> input-bg: #2a3942;
    out property <color> hover: #1a262d;
    out property <color> selected: #2a3942;
    out property <color> divider: #222d34;
    out property <color> tick-read: #53bdeb;
    out property <color> danger: #ea4335;
    out property <color> warn: #f5a623;
    // Chat text size factor from the settings page.
    in-out property <float> font-scale: 1.0;
}

export struct ChatItem {
    jid: string,
    name: string,
    preview: string,
    time: string,
    unread: int,
    pinned: bool,
    archived: bool,
    muted: bool,
    // Read receipts are off for this chat.
    receipts-off: bool,
    // The chat has a disappearing-messages timer on.
    disappearing: bool,
    // One-to-one chat (can be blocked) and blocked by us.
    is-dm: bool,
    blocked: bool,
    // The preview is the unsent draft of the chat.
    draft: bool,
    avatar: image,
    has-avatar: bool,
    initials: string,
    tint: color,
}

// state: 0 connected, 1 connecting, 2 disconnected.
export struct ProfileItem {
    id: string,
    name: string,
    initials: string,
    color: color,
    avatar: image,
    has-avatar: bool,
    unread: int,
    state: int,
    active: bool,
}

export component Avatar inherits Rectangle {
    in property <image> source;
    in property <bool> has-image;
    in property <string> initials;
    in property <color> tint;
    in property <length> size: 49px;

    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    background: root.has-image ? Theme.panel : root.tint;
    clip: true;

    if !root.has-image: Text {
        text: root.initials;
        color: white;
        font-size: root.size * 0.38;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if root.has-image: Image {
        source: root.source;
        width: 100%;
        height: 100%;
        image-fit: cover;
    }
}
