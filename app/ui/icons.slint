import { Theme } from "theme.slint";

// Icons drawn with Path commands on a 24x24 grid, so they never depend on the
// UI font having the glyph (it renders boxes for symbols such as the cross).
// Strokes are in logical pixels, independent of `size`.

export component IconClose inherits Path {
    in property <color> color: Theme.text;
    in property <length> size: 16px;
    width: root.size;
    height: root.size;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke: root.color;
    stroke-width: 1.8px;
    stroke-line-cap: round;
    commands: "M 6 6 L 18 18 M 18 6 L 6 18";
}

