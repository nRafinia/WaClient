import { Theme } from "theme.slint";

// One square of the month grid. `day` 0 is an empty filler.
export struct CalendarCell {
    day: int,
    enabled: bool,
    selected: bool,
}

// Month calendar shown over the window: "Jump to date" in the chat search and
// the custom range of the global search. Driven from Rust (app/search_ui.rs).
export global CalendarState {
    in-out property <bool> open;
    in property <string> heading;
    in property <string> title;
    in property <[CalendarCell]> cells;
    in property <bool> can-prev;
    in property <bool> can-next;
    callback prev();
    callback next();
    callback pick(int);
    callback close();
    // The calendar button of the chat search: Rust fills the month and sets `open`.
    callback open-jump();
}

component MonthButton inherits Rectangle {
    in property <bool> enabled: true;
    in property <bool> back: false;
    callback clicked();
    width: 32px;
    height: 32px;
    border-radius: 16px;
    background: ta.has-hover && root.enabled ? Theme.hover : transparent;
    opacity: root.enabled ? 1.0 : 0.3;
    Path {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        viewbox-width: 24;
        viewbox-height: 24;
        stroke: Theme.text;
        stroke-width: 1.8px;
        stroke-line-cap: round;
        stroke-line-join: round;
        fill: transparent;
        commands: root.back ? "M 15 5 L 8 12 L 15 19" : "M 9 5 L 16 12 L 9 19";
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

export component CalendarOverlay inherits Rectangle {
    background: #00000099;
    // Swallows clicks outside the card.
    TouchArea {
        clicked => { CalendarState.close(); }
    }

    Rectangle {
        width: 308px;
        height: 380px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.panel;
        border-radius: 12px;
        TouchArea { }

        Text {
            x: 20px;
            y: 14px;
            width: parent.width - 40px;
            height: 22px;
            text: CalendarState.heading;
            color: Theme.secondary;
            font-size: 13px;
        }
        MonthButton {
            x: 12px;
            y: 40px;
            back: true;
            enabled: CalendarState.can-prev;
            clicked => { CalendarState.prev(); }
        }
        Text {
            x: 52px;
            y: 40px;
            width: parent.width - 104px;
            height: 32px;
            text: CalendarState.title;
            color: Theme.text;
            font-size: 16px;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        MonthButton {
            x: parent.width - 44px;
            y: 40px;
            enabled: CalendarState.can-next;
            clicked => { CalendarState.next(); }
        }

        for name[i] in ["Mo", "Tu", "We", "Th", "Fr", "Sa", "Su"]: Text {
            x: 14px + i * 40px;
            y: 84px;
            width: 40px;
            height: 22px;
            text: name;
            color: Theme.secondary;
            font-size: 12px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        for cell[i] in CalendarState.cells: Rectangle {
            x: 14px + mod(i, 7) * 40px;
            y: 110px + floor(i / 7) * 40px;
            width: 40px;
            height: 40px;
            if cell.day > 0: Rectangle {
                x: 2px;
                y: 2px;
                width: 36px;
                height: 36px;
                border-radius: 18px;
                background: cell.selected ? Theme.accent : (day-ta.has-hover && cell.enabled ? Theme.selected : transparent);
                Text {
                    text: cell.day;
                    color: cell.selected ? #111b21 : (cell.enabled ? Theme.text : Theme.secondary);
                    opacity: cell.enabled ? 1.0 : 0.35;
                    font-size: 14px;
                    font-weight: cell.enabled ? 600 : 400;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                // A dot under the days that hold messages.
                if cell.enabled && !cell.selected: Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: parent.height - 7px;
                    width: 4px;
                    height: 4px;
                    border-radius: 2px;
                    background: Theme.accent;
                }
                day-ta := TouchArea {
                    enabled: cell.enabled;
                    mouse-cursor: cell.enabled ? pointer : default;
                    clicked => { CalendarState.pick(cell.day); }
                }
            }
        }

        Rectangle {
            x: parent.width - 96px;
            y: parent.height - 48px;
            width: 80px;
            height: 34px;
            border-radius: 17px;
            background: close-ta.has-hover ? Theme.hover : transparent;
            Text {
                text: "Close";
                color: Theme.accent;
                font-size: 14px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            close-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { CalendarState.close(); }
            }
        }
    }
}
