import { ListView } from "std-widgets.slint";
import { Theme, Avatar } from "theme.slint";
import { IconClose } from "icons.slint";
import { MsgOps } from "msgops.slint";

component TimeLine inherits Rectangle {
    in property <string> label;
    in property <string> value;
    height: 22px;
    Text {
        x: 0px;
        width: 92px;
        text: root.label;
        color: Theme.secondary;
        font-size: 13px;
        vertical-alignment: center;
    }
    Text {
        x: 96px;
        width: parent.width - 96px;
        text: root.value == "" ? "-" : root.value;
        color: root.value == "" ? Theme.secondary : Theme.text;
        font-size: 13px;
        vertical-alignment: center;
        overflow: elide;
    }
}

// Right panel: who received / read one of our messages.
export component MessageInfoPanel inherits Rectangle {
    background: Theme.chat-bg;
    TouchArea { }

    property <length> top: 76px + preview-text.preferred-height + 22px + 16px;

    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 60px;
        background: Theme.panel;
        Rectangle {
            x: 8px;
            y: 12px;
            width: 36px;
            height: 36px;
            border-radius: 18px;
            background: close-ta.has-hover ? Theme.hover : transparent;
            IconClose {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                color: Theme.secondary;
            }
            close-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { MsgOps.panel-close(); }
            }
        }
        Text {
            x: 60px;
            text: "Message info";
            color: Theme.text;
            font-size: 17px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }

    // The message itself, as a bubble preview.
    Rectangle {
        y: 76px;
        x: 16px;
        width: parent.width - 32px;
        height: preview-text.preferred-height + 22px;
        background: Theme.my-bubble;
        border-radius: 8px;
        preview-text := Text {
            x: 10px;
            y: 6px;
            width: parent.width - 20px;
            text: MsgOps.info-preview;
            color: Theme.text;
            font-size: 14px;
            wrap: word-wrap;
        }
        Text {
            x: 10px;
            y: parent.height - 18px;
            width: parent.width - 20px;
            text: MsgOps.info-time;
            color: Theme.secondary;
            font-size: 11px;
            horizontal-alignment: right;
        }
    }

    // Direct chats: one compact block, no recipient list.
    if MsgOps.info-compact: VerticalLayout {
        x: 20px;
        y: root.top;
        width: parent.width - 40px;
        spacing: 4px;
        if MsgOps.info-rows.length > 0: TimeLine {
            label: "Read";
            value: MsgOps.info-rows[0].read;
        }
        if MsgOps.info-rows.length > 0: TimeLine {
            label: "Delivered";
            value: MsgOps.info-rows[0].delivered;
        }
        if MsgOps.info-rows.length > 0 && MsgOps.info-rows[0].played != "": TimeLine {
            label: "Played";
            value: MsgOps.info-rows[0].played;
        }
        if MsgOps.info-rows.length == 0: Text {
            text: MsgOps.info-loading ? "Loading…" : "No receipt details yet";
            color: Theme.secondary;
            font-size: 13px;
        }
    }

    if !MsgOps.info-compact: Rectangle {
        y: root.top;
        height: parent.height - root.top;
        Text {
            x: 20px;
            y: 0px;
            text: MsgOps.info-rows.length == 0 ? (MsgOps.info-loading ? "Loading…" : "No receipt details yet") : "Recipients";
            color: Theme.accent;
            font-size: 13px;
            font-weight: 600;
        }
        ListView {
            y: 24px;
            height: parent.height - 24px;
            for r in MsgOps.info-rows: Rectangle {
                height: 108px;
                Avatar {
                    x: 20px;
                    y: 10px;
                    size: 36px;
                    has-image: false;
                    initials: r.initials;
                    tint: r.tint;
                }
                Text {
                    x: 66px;
                    y: 10px;
                    width: parent.width - 86px;
                    height: 36px;
                    text: r.name;
                    color: Theme.text;
                    font-size: 15px;
                    overflow: elide;
                    vertical-alignment: center;
                }
                VerticalLayout {
                    x: 66px;
                    y: 52px;
                    width: parent.width - 86px;
                    spacing: 2px;
                    TimeLine {
                        label: "Read";
                        value: r.read;
                    }
                    TimeLine {
                        label: "Delivered";
                        value: r.delivered;
                    }
                    if r.played != "": TimeLine {
                        label: "Played";
                        value: r.played;
                    }
                }
            }
        }
    }
}
