import { Button } from "std-widgets.slint";
import { PopupState, Theme, Avatar, ProfileItem } from "theme.slint";
import { TextDir } from "chat_search.slint";


component Tip inherits Rectangle {
    in property <string> text;
    width: label.preferred-width + 24px;
    height: 30px;
    background: Theme.input-bg;
    border-radius: 6px;
    border-width: 1px;
    border-color: Theme.divider;
    label := Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        color: Theme.text;
        font-size: 13px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component MenuEntry inherits Rectangle {
    in property <string> text;
    in property <bool> danger;
    in property <bool> enabled: true;
    callback clicked();
    height: 38px;
    border-radius: 6px;
    background: root.enabled && area.has-hover ? Theme.selected : transparent;
    Text {
        x: 12px;
        width: parent.width - 24px;
        text: root.text;
        color: root.danger ? Theme.danger : Theme.text;
        opacity: root.enabled ? 1.0 : 0.4;
        font-size: 14px;
        vertical-alignment: center;
    }
    area := TouchArea {
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
    }
}

component RailItem inherits Rectangle {
    in property <ProfileItem> item;
    in property <int> index;
    in property <int> count;
    callback clicked();
    callback rename();
    callback remove();
    callback move-to(int);
    // Target slot while dragging, -1 when the drag ends.
    callback drag-over(int);

    // Drag-to-reorder: a press that travels more than 6px starts a drag, the
    // icon follows the pointer and the drop moves it to the slot under it.
    private property <bool> left-down;
    private property <bool> dragging;
    private property <bool> dragged;
    private property <length> dy;
    private property <int> target: Math.max(0, Math.min(root.count - 1, root.index + Math.round(root.dy / 64px)));

    height: 64px;
    z: root.dragging ? 10 : 0;

    Rectangle {
        y: root.dragging ? root.dy : 0px;
        width: parent.width;
        height: parent.height;
        opacity: root.dragging ? 0.85 : 1.0;
    Rectangle {
        x: 0px;
        width: 4px;
        y: (parent.height - self.height) / 2;
        height: root.item.active ? 36px : (area.has-hover ? 16px : 0px);
        border-radius: 2px;
        background: Theme.accent;
        animate height { duration: 120ms; }
    }
    Avatar {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        size: 44px;
        source: root.item.avatar;
        has-image: root.item.has-avatar;
        initials: root.item.initials;
        tint: root.item.color;
    }
    // Connection state: green connected, amber connecting, red disconnected.
    Rectangle {
        x: (parent.width + 44px) / 2 - self.width + 1px;
        y: (parent.height + 44px) / 2 - self.height + 1px;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: root.item.state == 0 ? #25d366 : (root.item.state == 1 ? Theme.warn : Theme.danger);
        border-width: 2px;
        border-color: Theme.chat-bg;
    }
    if root.item.unread > 0: Rectangle {
        x: parent.width - self.width - 2px;
        y: 4px;
        width: max(20px, badge-text.preferred-width + 10px);
        height: 20px;
        border-radius: 10px;
        background: Theme.badge;
        border-width: 2px;
        border-color: Theme.chat-bg;
        badge-text := Text {
            text: root.item.unread > 99 ? "99+" : root.item.unread;
            color: #111b21;
            font-size: 11px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    }
    area := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            if (!root.dragged) {
                root.clicked();
            }
        }
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                root.left-down = e.button == PointerEventButton.left;
                root.dragged = false;
                if e.button == PointerEventButton.right {
                    menu.show();
                }
            } else if e.kind == PointerEventKind.up && root.dragging {
                root.dragging = false;
                root.dragged = true;
                root.dy = 0px;
                root.drag-over(-1);
                if root.target != root.index {
                    root.move-to(root.target);
                }
            }
        }
        moved => {
            if (root.left-down && self.pressed) {
                root.dy = self.mouse-y - self.pressed-y;
                if (!root.dragging && Math.abs(root.dy / 1px) > 6) {
                    root.dragging = true;
                }
                if (root.dragging) {
                    root.drag-over(root.target);
                }
            }
        }
    }
    if area.has-hover && !root.dragging: Tip {
        x: parent.width - 2px;
        y: (parent.height - self.height) / 2;
        text: root.item.name;
    }
    property <bool> menu-shown: menu.is-open;
    changed menu-shown => { PopupState.open = max(0, PopupState.open + (self.menu-shown ? 1 : -1)); }
    menu := PopupWindow {
        x: parent.width - 8px;
        y: 8px;
        width: 200px;
        height: 162px;
        Rectangle {
            background: Theme.panel;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.divider;
            VerticalLayout {
                padding: 5px;
                MenuEntry {
                    text: "Move up";
                    enabled: root.index > 0;
                    clicked => { root.move-to(root.index - 1); menu.close(); }
                }
                MenuEntry {
                    text: "Move down";
                    enabled: root.index < root.count - 1;
                    clicked => { root.move-to(root.index + 1); menu.close(); }
                }
                MenuEntry {
                    text: "Rename";
                    clicked => { root.rename(); menu.close(); }
                }
                MenuEntry {
                    text: "Log out & remove";
                    danger: true;
                    clicked => { root.remove(); menu.close(); }
                }
            }
        }
    }
}

component AddButton inherits Rectangle {
    in property <bool> enabled;
    in property <string> tip;
    callback clicked();

    height: 64px;
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 44px;
        height: 44px;
        border-radius: 22px;
        background: root.enabled && area.has-hover ? Theme.selected : Theme.panel;
        opacity: root.enabled ? 1.0 : 0.4;
        Text {
            text: "+";
            color: Theme.text;
            font-size: 26px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    area := TouchArea {
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
    }
    if area.has-hover: Tip {
        x: parent.width - 2px;
        y: (parent.height - self.height) / 2;
        text: root.tip;
    }
}

export component ProfileRail inherits Rectangle {
    in property <[ProfileItem]> profiles;
    in property <bool> can-add;
    in property <string> add-tip;
    callback selected(string);
    callback add();
    callback rename(string, string);
    callback remove(string, string);
    // (profile id, new position)
    callback move(string, int);

    private property <int> drag-from: -1;
    private property <int> drag-to: -1;

    width: 64px;
    background: Theme.chat-bg;

    VerticalLayout {
        alignment: start;
        padding-top: 8px;
        for p[i] in root.profiles: RailItem {
            item: p;
            index: i;
            count: root.profiles.length;
            clicked => { root.selected(p.id); }
            move-to(to) => { root.move(p.id, to); }
            drag-over(to) => {
                root.drag-from = i;
                root.drag-to = to;
            }
            rename => { root.rename(p.id, p.name); }
            remove => { root.remove(p.id, p.name); }
        }
    }
    if root.drag-to >= 0 && root.drag-to != root.drag-from: Rectangle {
        x: 10px;
        width: parent.width - 20px;
        height: 3px;
        border-radius: 1.5px;
        y: 8px + (root.drag-to > root.drag-from ? root.drag-to + 1 : root.drag-to) * 64px - 1px;
        background: Theme.accent;
    }
    AddButton {
        y: parent.height - self.height - 8px;
        width: parent.width;
        enabled: root.can-add;
        tip: root.add-tip;
        clicked => { root.add(); }
    }
    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        background: Theme.divider;
    }
}

// Modal dialogs of the rail. kind: 0 hidden, 1 rename, 2 log out and remove.
export component ProfileDialog inherits Rectangle {
    in property <int> kind;
    in property <string> name;
    callback accept-rename(string);
    callback accept-remove();
    callback cancel();

    private property <string> draft;

    background: #000000b0;
    TouchArea { }

    Rectangle {
        width: min(400px, parent.width - 32px);
        height: dialog-body.preferred-height + 40px;
        background: Theme.panel;
        border-radius: 12px;

        dialog-body := VerticalLayout {
            padding: 20px;
            spacing: 14px;
            if root.kind == 1: Text {
                text: "Rename profile";
                color: Theme.text;
                font-size: 18px;
                font-weight: 600;
            }
            if root.kind == 1: Rectangle {
                height: 40px;
                background: Theme.input-bg;
                border-radius: 8px;
                border-width: 1px;
                border-color: Theme.accent;
                FocusScope {
                    key-pressed(e) => {
                        if (e.text == Key.Escape) {
                            root.cancel();
                            return accept;
                        }
                        return reject;
                    }
                    input := TextInput {
                        x: 12px;
                        width: parent.width - 24px;
                        height: parent.height;
                        text: root.name;
                        color: Theme.text;
                        font-size: 15px;
                        single-line: true;
                        horizontal-alignment: TextDir.is-rtl(self.text) ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;

                        vertical-alignment: center;
                        edited => { root.draft = self.text; }
                        accepted => { root.accept-rename(self.text); }
                        init => {
                            root.draft = root.name;
                            self.focus();
                            self.select-all();
                        }
                    }
                }
            }
            if root.kind == 2: Text {
                text: "Log out and remove \"" + root.name + "\"?";
                color: Theme.text;
                font-size: 18px;
                font-weight: 600;
                wrap: word-wrap;
            }
            if root.kind == 2: Text {
                text: "This unlinks the device from WhatsApp and deletes this profile's messages and downloaded media from this computer. It cannot be undone.";
                color: Theme.secondary;
                font-size: 14px;
                wrap: word-wrap;
            }
            HorizontalLayout {
                alignment: end;
                spacing: 10px;
                Button {
                    text: "Cancel";
                    clicked => { root.cancel(); }
                }
                if root.kind == 1: Button {
                    text: "Rename";
                    primary: true;
                    clicked => { root.accept-rename(root.draft); }
                }
                if root.kind == 2: Button {
                    text: "Log out & remove";
                    primary: true;
                    clicked => { root.accept-remove(); }
                }
            }
        }
    }
}
