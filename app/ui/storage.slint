import { Theme } from "theme.slint";
import { IconCheck } from "icons.slint";

export struct StorageChat {
    jid: string,
    name: string,
    size: string,
}

export struct StorageSegment {
    // Position in the type list; picks the colour.
    idx: int,
    label: string,
    size: string,
    // Share of the bar before this segment, and its own share.
    start: float,
    frac: float,
}

export struct StorageType {
    label: string,
    on: bool,
}

// Driven from Rust (app/storage_ui.rs). dialog: 0 closed, 1 clear one chat,
// 2 "Clear cache" with types and age.
export global StorageUsage {
    in property <bool> busy: true;
    in property <string> total-text;
    in property <string> db-text;
    in property <string> media-text;
    in property <string> avatars-text;
    in property <[StorageSegment]> segments;
    in property <[StorageChat]> chats;
    in property <string> status;
    in property <int> dialog;
    in property <string> dialog-title;
    in property <string> dialog-text;
    in property <bool> dialog-can-clear;
    in property <[StorageType]> types;
    in property <[string]> ages: ["Any age", "7 days", "30 days", "3 months", "1 year"];
    in property <int> age;
    callback refresh();
    callback ask-chat(string);
    callback open-dialog();
    callback toggle-type(int);
    callback set-age(int);
    callback confirm();
    callback cancel();
}

component StorageButton inherits Rectangle {
    in property <string> text;
    in property <color> fill: Theme.input-bg;
    in property <color> label-color: Theme.text;
    in property <bool> enabled: true;
    callback clicked();

    height: 32px;
    min-width: 80px;
    opacity: root.enabled ? 1.0 : 0.5;
    border-radius: 16px;
    background: area.pressed ? fill.darker(0.2) : (area.has-hover ? fill.brighter(0.1) : fill);

    area := TouchArea {
        mouse-cursor: pointer;
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    Text {
        text: root.text;
        color: root.label-color;
        font-size: 13px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component Swatch inherits Rectangle {
    in property <int> index;
    width: 10px;
    height: 10px;
    border-radius: 5px;
    background: [#53bdeb, #e0a030, #25d366, #e9567b, #a070d8, #8696a0][Math.min(root.index, 5)];
}

// Settings > Storage: usage of this profile and the media cleaner.
export component StorageSection inherits VerticalLayout {
    spacing: 6px;
    init => { StorageUsage.refresh(); }

    Rectangle { height: 6px; }
    VerticalLayout {
        padding-left: 24px;
        padding-right: 24px;
        spacing: 8px;
        Text {
            text: "Storage used by this profile";
            color: Theme.text;
            font-size: 15px;
        }
        Text {
            text: StorageUsage.busy ? "Calculating…" : StorageUsage.total-text;
            color: Theme.text;
            font-size: 22px;
            font-weight: 600;
        }
        if !StorageUsage.busy: Text {
            text: "Database " + StorageUsage.db-text + "  ·  Media " + StorageUsage.media-text + "  ·  Avatars " + StorageUsage.avatars-text;
            color: Theme.secondary;
            font-size: 12px;
            wrap: word-wrap;
        }
        bar := Rectangle {
            height: 12px;
            border-radius: 6px;
            background: Theme.input-bg;
            clip: true;
            for seg in StorageUsage.segments: Rectangle {
                x: bar.width * seg.start;
                width: bar.width * seg.frac;
                background: [#53bdeb, #e0a030, #25d366, #e9567b, #a070d8, #8696a0][Math.min(seg.idx, 5)];
            }
        }
        if !StorageUsage.busy: Rectangle {
            height: 4px;
        }
        if !StorageUsage.busy: VerticalLayout {
            spacing: 3px;
            for seg in StorageUsage.segments: HorizontalLayout {
                spacing: 5px;
                VerticalLayout {
                    alignment: center;
                    Swatch { index: seg.idx; }
                }
                Text {
                    text: seg.label + " " + seg.size;
                    color: Theme.secondary;
                    font-size: 12px;
                    vertical-alignment: center;
                }
            }
        }
        HorizontalLayout {
            alignment: start;
            spacing: 12px;
            StorageButton {
                text: "Clear cache…";
                width: 130px;
                enabled: !StorageUsage.busy;
                clicked => { StorageUsage.open-dialog(); }
            }
        }
        if StorageUsage.status != "": Text {
            text: StorageUsage.status;
            color: Theme.secondary;
            font-size: 12px;
            wrap: word-wrap;
        }
    }

    if StorageUsage.chats.length > 0: Rectangle {
        height: 30px;
        Text {
            x: 24px;
            text: "Chats by media size";
            color: Theme.accent;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
    for c in StorageUsage.chats: HorizontalLayout {
        padding-left: 24px;
        padding-right: 24px;
        spacing: 12px;
        height: 44px;
        Text {
            text: c.name;
            horizontal-stretch: 1;
            color: Theme.text;
            font-size: 14px;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            text: c.size;
            color: Theme.secondary;
            font-size: 13px;
            width: 76px;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            StorageButton {
                text: "Clear media";
                width: 110px;
                height: 30px;
                enabled: !StorageUsage.busy;
                clicked => { StorageUsage.ask-chat(c.jid); }
            }
        }
    }
}

component TypeRow inherits Rectangle {
    in property <string> label;
    in property <bool> on;
    callback toggled();
    height: 32px;
    background: ta.has-hover ? Theme.selected : transparent;
    border-radius: 8px;
    Rectangle {
        x: 8px;
        y: (parent.height - self.height) / 2;
        width: 18px;
        height: 18px;
        border-radius: 4px;
        border-width: 2px;
        border-color: root.on ? Theme.accent : Theme.secondary;
        background: root.on ? Theme.accent : transparent;
        if root.on: IconCheck {
            size: 14px;
            x: 0px;
            y: 0px;
            color: #111b21;
        }
    }
    Text {
        x: 36px;
        text: root.label;
        color: Theme.text;
        font-size: 14px;
        vertical-alignment: center;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }
}

// Modal for both clearing flows. Covers its parent.
export component StorageDialog inherits Rectangle {
    background: #000000b0;
    TouchArea { }

    FocusScope {
        width: parent.width;
        height: parent.height;
        init => { self.focus(); }
        capture-key-pressed(e) => {
            if (e.text == Key.Escape) {
                StorageUsage.cancel();
                return accept;
            }
            return reject;
        }

        Rectangle {
            width: min(420px, parent.width - 32px);
            height: body.preferred-height;
            background: Theme.panel;
            border-radius: 12px;

            body := VerticalLayout {
                padding: 20px;
                spacing: 8px;
                Text {
                    text: StorageUsage.dialog-title;
                    color: Theme.text;
                    font-size: 18px;
                    font-weight: 600;
                    wrap: word-wrap;
                }
                if StorageUsage.dialog == 2: VerticalLayout {
                    spacing: 2px;
                    for t[i] in StorageUsage.types: TypeRow {
                        label: t.label;
                        on: t.on;
                        toggled => { StorageUsage.toggle-type(i); }
                    }
                    Text {
                        text: "Older than";
                        color: Theme.secondary;
                        font-size: 13px;
                        height: 28px;
                        vertical-alignment: bottom;
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        for a[i] in StorageUsage.ages: Rectangle {
                            property <bool> on: i == StorageUsage.age;
                            height: 30px;
                            min-width: 56px;
                            border-radius: 15px;
                            border-width: 1px;
                            border-color: self.on ? Theme.accent : Theme.divider;
                            background: self.on ? Theme.accent : (chip-ta.has-hover ? Theme.selected : transparent);
                            Text {
                                text: a;
                                color: parent.on ? #111b21 : Theme.text;
                                font-size: 12px;
                                font-weight: 600;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            chip-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { StorageUsage.set-age(i); }
                            }
                        }
                    }
                }
                Text {
                    text: StorageUsage.dialog-text;
                    color: Theme.text;
                    font-size: 14px;
                    font-weight: 600;
                    wrap: word-wrap;
                }
                Text {
                    text: "Messages are never deleted, and starred messages keep their media. Media can be downloaded again while it's still available on WhatsApp's servers.";
                    color: Theme.secondary;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                Rectangle { height: 6px; }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    StorageButton {
                        text: "Cancel";
                        clicked => { StorageUsage.cancel(); }
                    }
                    StorageButton {
                        text: "Clear";
                        fill: Theme.accent;
                        label-color: white;
                        enabled: StorageUsage.dialog-can-clear;
                        clicked => { StorageUsage.confirm(); }
                    }
                }
            }
        }
    }
}
