import { Button, ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { IconClose } from "icons.slint";

export struct PollField {
    text: string,
}

// State of the "Create poll" dialog (Rust: app/poll_ui.rs). The option fields
// are a model owned by the controller: it keeps one empty field at the end.
export global PollState {
    in-out property <bool> open;
    in-out property <string> question;
    // "Allow multiple answers".
    in-out property <bool> multi: true;
    in property <[PollField]> fields;
    // The poll could be sent as it is.
    in property <bool> valid;
    // Why not (only once it is clearly wrong, e.g. two equal options).
    in property <string> hint;
    callback question-edited(string);
    callback option-edited(int, string);
    callback remove-option(int);
    callback send();
    callback cancel();
}

// A single-line text field. `value` is pushed in by the controller (rows shift
// when one is removed); typing reports through `edited`.
component PollInput inherits Rectangle {
    in property <string> placeholder;
    in property <string> value;
    in property <bool> autofocus: false;
    callback edited(string);

    height: 38px;
    background: Theme.input-bg;
    border-radius: 8px;
    // Typing replaces the binding of `text`, so a later push has to be copied by hand.
    changed value => { input.text = root.value; }

    if input.text == "": Text {
        x: 12px;
        width: parent.width - 24px;
        text: root.placeholder;
        color: Theme.secondary;
        font-size: 14px;
        vertical-alignment: center;
        overflow: elide;
    }
    input := TextInput {
        x: 12px;
        y: (parent.height - self.preferred-height) / 2;
        width: parent.width - 24px;
        color: Theme.text;
        font-size: 14px;
        single-line: true;
        text: root.value;
        init => {
            if (root.autofocus) {
                self.focus();
            }
        }
        edited => { root.edited(self.text); }
    }
}

// Modal dialog that covers its parent: question, options, "Allow multiple
// answers" and Send.
export component CreatePollDialog inherits Rectangle {
    background: #000000b0;
    TouchArea { }

    FocusScope {
        width: parent.width;
        height: parent.height;
        capture-key-pressed(e) => {
            if (e.text == Key.Escape) {
                PollState.cancel();
                return accept;
            }
            return reject;
        }

        Rectangle {
            width: min(440px, parent.width - 32px);
            height: min(560px, parent.height - 32px);
            background: Theme.panel;
            border-radius: 12px;
            clip: true;

            Text {
                x: 20px;
                y: 16px;
                width: parent.width - 40px;
                height: 26px;
                text: "Create poll";
                color: Theme.text;
                font-size: 18px;
                font-weight: 600;
            }

            Text {
                x: 20px;
                y: 52px;
                text: "Question";
                color: Theme.secondary;
                font-size: 13px;
            }
            PollInput {
                x: 20px;
                y: 72px;
                width: parent.width - 40px;
                placeholder: "Ask a question";
                value: PollState.question;
                autofocus: true;
                edited(t) => {
                    PollState.question = t;
                    PollState.question-edited(t);
                }
            }

            Text {
                x: 20px;
                y: 124px;
                text: "Options";
                color: Theme.secondary;
                font-size: 13px;
            }
            ListView {
                x: 20px;
                y: 146px;
                width: parent.width - 40px;
                height: parent.height - 146px - 68px - 112px;

                for f[i] in PollState.fields: Rectangle {
                    height: 46px;

                    PollInput {
                        x: 0px;
                        y: 0px;
                        width: parent.width - 40px;
                        placeholder: "Option \{i + 1}";
                        value: f.text;
                        edited(t) => { PollState.option-edited(i, t); }
                    }
                    if PollState.fields.length > 2 && !(i == PollState.fields.length - 1 && f.text == ""): Rectangle {
                        x: parent.width - 32px;
                        y: 5px;
                        width: 28px;
                        height: 28px;
                        border-radius: 14px;
                        background: rm-ta.has-hover ? Theme.selected : transparent;
                        IconClose {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            size: 14px;
                            color: Theme.secondary;
                        }
                        rm-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { PollState.remove-option(i); }
                        }
                    }
                }
            }

            Rectangle {
                x: 20px;
                y: parent.height - 68px - 100px;
                width: parent.width - 40px;
                height: 28px;
                Text {
                    width: parent.width;
                    height: parent.height;
                    text: PollState.hint;
                    color: Theme.danger;
                    font-size: 12.5px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }

            // "Allow multiple answers" switch.
            Rectangle {
                x: 20px;
                y: parent.height - 68px - 64px;
                width: parent.width - 40px;
                height: 44px;
                Text {
                    x: 0px;
                    width: parent.width - 60px;
                    height: parent.height;
                    text: "Allow multiple answers";
                    color: Theme.text;
                    font-size: 14.5px;
                    vertical-alignment: center;
                }
                Rectangle {
                    x: parent.width - 44px;
                    y: (parent.height - self.height) / 2;
                    width: 44px;
                    height: 24px;
                    border-radius: 12px;
                    background: PollState.multi ? Theme.accent : Theme.input-bg;
                    border-width: PollState.multi ? 0px : 1px;
                    border-color: Theme.secondary;
                    Rectangle {
                        x: PollState.multi ? parent.width - self.width - 3px : 3px;
                        y: 3px;
                        width: 18px;
                        height: 18px;
                        border-radius: 9px;
                        background: PollState.multi ? white : Theme.secondary;
                        animate x { duration: 120ms; }
                    }
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { PollState.multi = !PollState.multi; }
                }
            }

            Rectangle {
                y: parent.height - 68px;
                height: 68px;
                Rectangle {
                    height: 1px;
                    background: Theme.divider;
                }
                HorizontalLayout {
                    x: parent.width - 232px;
                    width: 220px;
                    alignment: end;
                    spacing: 8px;
                    padding-top: 16px;
                    padding-bottom: 16px;
                    Button {
                        text: "Cancel";
                        clicked => { PollState.cancel(); }
                    }
                    Button {
                        text: "Send";
                        primary: true;
                        enabled: PollState.valid;
                        clicked => { PollState.send(); }
                    }
                }
            }
        }
    }
}
